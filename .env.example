# Copy the values you need into an untracked .env file, or deployment variables.
# Brevo HTTPS API works on Railway Free, Trial, and Hobby plans.
MAIL_PROVIDER=brevo
BREVO_API_KEY=replace-with-your-brevo-api-key
MAIL_DEFAULT_SENDER=replace-with-your-verified-sender@example.com
MAIL_SUPPRESS_SEND=false

# Optional SMTP alternative: set MAIL_PROVIDER=smtp and fill these values.
# Railway outbound SMTP requires Pro or above.
# MAIL_SERVER=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USE_SSL=false
# MAIL_USERNAME=replace-with-your-brevo-smtp-login
# MAIL_PASSWORD=replace-with-your-brevo-smtp-key
